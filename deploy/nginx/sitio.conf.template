# Sitio HTTPS de la plataforma. La imagen de Nginx sustituye ${PUBLIC_SITE_DOMAIN} al arrancar (solo las variables
# definidas en el entorno: las de Nginx, como $host, no se tocan).
# Certificado institucional en deploy/nginx/certs/ (fullchain.pem + privkey.pem), colocado a mano en el servidor y nunca
# versionado: ver README, «Producción con Docker», «Certificado SSL».

# HTTP: solo redirige el dominio a HTTPS; cualquier otro nombre (o la IP) se cierra sin respuesta.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}
server {
    listen 80;
    server_name ${PUBLIC_SITE_DOMAIN};
    return 301 https://${PUBLIC_SITE_DOMAIN}$request_uri;
}

# HTTPS para nombres que no son el dominio: se rechaza el saludo TLS (no se muestra el certificado).
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PUBLIC_SITE_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # HSTS (la app no lo fija: next.config.mjs). Sin includeSubDomains: solo este dominio.
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Límite global por archivo de la app: 20 MB (lib/archivos.ts, LIMITE_GLOBAL_BYTES) más el margen del multipart.
    client_max_body_size 21m;

    include /etc/nginx/plataforma/ubicaciones.conf;
}
