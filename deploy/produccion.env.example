# Plantilla del .env de PRODUCCIÓN (docker-compose.prod.yml). En el servidor:
#   cp deploy/produccion.env.example .env && chmod 600 .env
# y sustituir cada CAMBIAR por un valor nuevo, solo de producción (nunca los de desarrollo). El .env no se versiona.
# Las tres contraseñas en hexadecimal (sin comillas ni símbolos: van dentro de una URI y de psql):
#   openssl rand -hex 32
# PAYLOAD_SECRET (firma las sesiones; cambiarlo cierra todas):
#   openssl rand -base64 48 | tr -d '\n/+='

# Dominio definitivo (sin https://). Debe coincidir con el certificado de deploy/nginx/certs/.
PUBLIC_SITE_DOMAIN=investigacionletras.unmsm.edu.pe

# PostgreSQL: base y superusuario del contenedor (solo administración: respaldos, roles.sql; la app no lo usa).
POSTGRES_DB=giflch
POSTGRES_USER=payload
POSTGRES_PASSWORD=CAMBIAR

# Roles de deploy/postgres/roles.sql, creados por deploy/primera-carga.sh:
#   plataforma_app    la aplicación (lee y escribe filas)
#   plataforma_owner  dueño del esquema; solo para migraciones futuras
PLATAFORMA_APP_PASSWORD=CAMBIAR
PLATAFORMA_OWNER_PASSWORD=CAMBIAR

PAYLOAD_SECRET=CAMBIAR
