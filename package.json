{
  "name": "plataforma-landings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "formato": "prettier --write .",
    "formato:comprobar": "prettier --check .",
    "knip": "knip",
    "verificar": "node scripts/verificar.mjs",
    "verificar:estatico": "node scripts/verificar.mjs --estatico",
    "verificar:sql": "node scripts/verificar/sql.mjs",
    "verificar:html": "node scripts/verificar/html.mjs",
    "verificar:secretos": "node scripts/verificar/secretos.mjs",
    "verificar:auditoria": "node scripts/verificar/auditoria.mjs",
    "verificar:enlaces": "node scripts/verificar/enlaces.mjs",
    "verificar:migraciones": "node scripts/verificar/migraciones.mjs",
    "verificar:roles": "node scripts/verificar/roles.mjs",
    "payload": "payload",
    "generate": "payload generate:importmap && payload generate:types",
    "migrate:create": "payload migrate:create",
    "migrate": "node scripts/migrar.mjs migrate",
    "migrate:status": "node scripts/migrar.mjs migrate:status",
    "db:up": "docker compose up -d",
    "db:down": "docker compose stop",
    "seed": "payload run scripts/seed.ts",
    "importar:grupos": "payload run scripts/importar-grupos-2026.ts",
    "test:aislamiento": "payload run scripts/test-aislamiento.ts",
    "test:seguridad": "payload run scripts/test-seguridad.ts",
    "test:formulario": "node --test scripts/test-formulario.mjs",
    "test:limite": "node --test scripts/test-limite.mjs",
    "test:archivos": "node --test scripts/test-archivos.mjs",
    "test:unitarias": "node --test scripts/test-formulario.mjs scripts/test-limite.mjs scripts/test-archivos.mjs scripts/test-pruebas-url.mjs"
  },
  "dependencies": {
    "@faceless-ui/modal": "3.0.0",
    "@faceless-ui/scroll-info": "2.0.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-multi-tenant": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "graphql": "16.11.0",
    "next": "16.4.3",
    "payload": "3.90.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "knip": "6.42.0",
    "prettier": "3.9.10",
    "typescript": "5.7.3"
  }
}
