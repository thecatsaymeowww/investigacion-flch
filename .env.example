# Copiar a .env (nunca commitear .env). Valores solo para localhost.

# Superusuario del contenedor de Postgres (docker-compose.yml). Solo administra el clúster
# (crear la base, ejecutar deploy/postgres/roles.sql); ni la app ni las migraciones lo usan.
POSTGRES_DB=giflch
POSTGRES_USER=payload
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_PORT=5434

# Rol de la aplicación (Next.js + Payload): solo lee y escribe filas. Ver docs/BASE-DE-DATOS.md.
DATABASE_URI=postgres://plataforma_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:5434/giflch
# Rol propietario del esquema: SOLO lo usa `pnpm migrate`, y NO va en este archivo. Next y Payload cargan todo .env
# en el proceso de la aplicación; la conexión del propietario va en .env.migraciones (ignorado por git, no lo carga
# nadie más que scripts/migrar.mjs), con una sola línea:
#   DATABASE_URI_MIGRACIONES=postgres://plataforma_owner:CHANGE_ME_OWNER_PASSWORD@127.0.0.1:5434/giflch
# POSTGRES_PASSWORD (arriba) sí debe estar aquí porque la usa Docker Compose; la app la retira de su entorno al arrancar.

PAYLOAD_SECRET=CHANGE_ME_PAYLOAD_SECRET
# URL pública del sitio: origen exacto con el que se abre el navegador, sin ruta (en local, http://localhost:3000
# o http://127.0.0.1:3000, la que se use). Es el serverURL de Payload y el único origen admitido para la sesión del
# panel (csrf): si no coincide, el panel no autentica. Se cambia al publicar en el dominio. Obligatoria.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Atributo Secure de la cookie de sesión. En producción (HTTPS) dejarla en true u omitirla; false solo para probar
# en local por HTTP (no se admite con un NEXT_PUBLIC_SITE_URL https).
PAYLOAD_COOKIE_SECURE=false
# Proxy de confianza para el límite de envíos del formulario (subfase 4b). Vacío o 0 en local: no se confía en ninguna
# cabecera y todos los envíos comparten un límite. 1 SOLO detrás del Nginx de deploy/nginx/ en la misma máquina, con la
# app escuchando en 127.0.0.1: entonces la IP del cliente es X-Real-IP, que Nginx sobrescribe. Un sitio https exige 1.
CONFIAR_EN_PROXY=

# Opcional: carpeta fuera del repositorio con los JSON e imágenes autorizados de Prensa y Literatura.
SEMILLA_PRENSA_DIR=
